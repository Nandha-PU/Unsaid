# LLM Provider configuration
# Options: fake | anthropic | openai | openai_compat | gemini | ollama
LLM_PROVIDER=gemini

# Model identifier (e.g. gemini-3.5-flash, or for Ollama: qwen3.5:latest, gemma3:latest, qwen3.5:0.8b)
LLM_MODEL=gemini-3.5-flash

# Optional fallback models when credits/quota are exhausted (comma-separated, Gemini only)
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite

# API Key (leave empty for fake or ollama)
LLM_API_KEY=

# Base URL (defaults to http://localhost:11434 for ollama; http://localhost:11434/v1 for openai_compat)
LLM_BASE_URL=http://localhost:11434

# Guardrails
MIN_DRAFT_CHARS=15
MAX_DRAFT_CHARS=3000
RATE_LIMIT_PER_MIN=30

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
